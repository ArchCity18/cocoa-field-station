# Cocoa Field Station - Local Development Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control

# PostgreSQL (shared database for both Streamlit and PHP API)
POSTGRES_PASSWORD=your_strong_random_password_here

# Streamlit secrets
STREAMLIT_COOKIE_SECRET=your_very_long_random_cookie_secret_at_least_32_characters
STREAMLIT_GOOGLE_CLIENT_ID=your_google_oauth_web_client_id
STREAMLIT_GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# PHP API secrets
PHP_PEPPER=your_very_long_random_pepper_at_least_32_characters
GOOGLE_WEB_CLIENT_ID=your_google_oauth_web_client_id
GOOGLE_ANDROID_CLIENT_ID=your_google_oauth_android_client_id
GOOGLE_IOS_CLIENT_ID=your_google_oauth_ios_client_id